                </div>

                <!-- Reviews Card -->
                <div class="stat-card rounded-xl p-6 shadow-md animate-slide-up" style="--accent-color: #f59e0b; --accent-color-light: #fcd34d; --accent-color-dark: #d97706; animation-delay: 0.4s;">
