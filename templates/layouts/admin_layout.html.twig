<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}CovoitUni Admin{% endblock %}</title>
        
        {# Google Fonts - Montserrat and Poppins #}
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        
        {# Our CSS file #}
        <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
        <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
        
        {# Tailwind CSS CDN #}
        <script src="https://cdn.tailwindcss.com"></script>
        
        {# Custom Tailwind Configuration #}
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            primary: '#00B140',
                            'primary-dark': '#008F34',
                            'primary-light': '#70e8a8',
                            'primary-ultra-light': '#e6fff0',
                            'text-dark': '#1A1A1A',
                            'bg-secondary': '#F5F5F5',
                            'error': '#FF3333',
                            'admin': {
                                'primary': '#3B82F6',
                                'secondary': '#1E40AF',
                                'accent': '#DBEAFE',
                                'light': '#EFF6FF',
                                'dark': '#1E3A8A'
                            }
                        },
                        fontFamily: {
                            montserrat: ['Montserrat', 'sans-serif'],
                            poppins: ['Poppins', 'sans-serif']
                        },
                        backdropBlur: {
                            'xs': '2px',
                        }
                    }
                }
            }
        </script>
        
        <style>
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #F8FAFC;
            }
            .sidebar {
                font-family: 'Poppins', sans-serif;
                height: 100vh;
                position: fixed;
                overflow-y: auto;
                scrollbar-width: thin;
                scrollbar-color: rgba(203, 213, 225, 0.5) transparent;
            }
            .sidebar::-webkit-scrollbar {
                width: 4px;
            }
            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }
            .sidebar::-webkit-scrollbar-thumb {
                background-color: rgba(203, 213, 225, 0.5);
                border-radius: 20px;
            }
            .main-content {
                margin-left: 270px;
                transition: margin-left 0.3s ease;
            }
            .main-content.expanded {
                margin-left: 80px;
            }
            .sidebar.collapsed {
                width: 80px;
            }
            .sidebar.collapsed .sidebar-text,
            .sidebar.collapsed .sidebar-footer,
            .sidebar.collapsed .profile-details {
                display: none;
            }
            .sidebar.collapsed .sidebar-logo {
                width: 100%;
                display: flex;
                justify-content: center;
            }
            .nav-blur {
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
            }
            .stat-card {
                transition: all 0.3s ease;
                overflow: hidden;
                position: relative;
            }
            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }
            @keyframes fadeIn {
                from { opacity: 0; }
                to { opacity: 1; }
            }
            @keyframes slideInUp {
                from { transform: translateY(20px); opacity: 0; }
                to { transform: translateY(0); opacity: 1; }
            }
            @keyframes scaleIn {
                from { transform: scale(0.9); opacity: 0; }
                to { transform: scale(1); opacity: 1; }
            }
            .animate-fade-in {
                animation: fadeIn 0.5s ease forwards;
            }
            .animate-slide-up {
                animation: slideInUp 0.5s ease forwards;
            }
            .animate-scale-in {
                animation: scaleIn 0.5s ease forwards;
            }
            .metric-value {
                font-size: 2rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
                color: #3B82F6;
            }
            .metric-label {
                color: #6b7280;
                font-size: 0.875rem;
            }
            .chart-container {
                position: relative;
                height: 250px;
                width: 100%;
            }
        </style>
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-slate-50 text-slate-800 font-poppins">
        {# Sidebar #}
        <aside id="sidebar" class="sidebar w-64 bg-white shadow-lg z-10">
            <div class="p-4 flex items-center justify-between border-b border-slate-100">
                <div class="sidebar-logo">
                    <a href="{{ path('app_admin_dashboard') }}" class="text-xl font-bold bg-gradient-to-r from-admin-primary to-admin-secondary bg-clip-text text-transparent hover:scale-105 transition-transform">
                        CovoitUni<span class="text-admin-primary">Admin</span>
                    </a>
                </div>
                <button id="sidebarToggle" class="p-1 rounded-full text-slate-400 hover:bg-slate-100">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                    </svg>
                </button>
            </div>
            
            <div class="p-4 border-b border-slate-100">
                <div class="flex items-center">
                    {% if user.imagePath %}
                        <img src="{{ asset(user.imagePath) }}" alt="{{ user.username }}" class="w-10 h-10 rounded-full object-cover mr-3 border-2 border-admin-accent">
                    {% else %}
                        <div class="w-10 h-10 rounded-full bg-gradient-to-r from-admin-primary to-admin-secondary flex items-center justify-center text-white text-sm font-bold mr-3">
                            {{ user.prenom|first }}{{ user.nom|first }}
                        </div>
                    {% endif %}
                    <div class="profile-details">
                        <p class="font-medium text-slate-900 text-sm">{{ user.prenom }} {{ user.nom }}</p>
                        <p class="text-xs text-admin-primary flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            Administrator
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="py-4">
                <nav class="space-y-1 px-2">
                    <a href="{{ path('app_admin_dashboard') }}" class="sidebar-link flex items-center px-3 py-2.5 text-sm font-medium rounded-lg {% if app.request.get('_route') == 'app_admin_dashboard' %}bg-admin-light text-admin-primary{% else %}text-slate-600 hover:bg-admin-light hover:text-admin-primary{% endif %} transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        <span class="sidebar-text">Dashboard</span>
                    </a>
                    <a href="{{ path('app_admin_users') }}" class="sidebar-link flex items-center px-3 py-2.5 text-sm font-medium rounded-lg {% if app.request.get('_route') starts with 'app_admin_user' or app.request.get('_route') == 'app_admin_users' or app.request.get('_route') == 'app_user_edit_roles' %}bg-admin-light text-admin-primary{% else %}text-slate-600 hover:bg-admin-light hover:text-admin-primary{% endif %} transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span class="sidebar-text">Gestion des utilisateurs</span>
                    </a>
                    <a href="#" class="sidebar-link flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-admin-light hover:text-admin-primary transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                            <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z" />
                        </svg>
                        <span class="sidebar-text">Gestion Voitures</span>
                    </a>
                    <a href="{{ path('app_admin_reclamation_index') }}" class="sidebar-link flex items-center px-3 py-2.5 text-sm font-medium rounded-lg {% if app.request.get('_route') starts with 'app_admin_reclamation' %}bg-admin-light text-admin-primary{% else %}text-slate-600 hover:bg-admin-light hover:text-admin-primary{% endif %} transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <span class="sidebar-text">Gestion Réclamations</span>
                    </a>
                    <a href="#" class="sidebar-link flex items-center px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-admin-light hover:text-admin-primary transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span class="sidebar-text">Gestion Events</span>
                    </a>
                </nav>
            </div>
            
            <div class="px-4 py-4 mt-auto border-t border-slate-100 sidebar-footer">
                <div class="mb-4">
                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Administration</h3>
                    <div class="space-y-1">
                        <a href="{{ path('app_admin_users') }}" class="flex items-center px-3 py-2 text-xs text-slate-600 hover:text-admin-primary rounded-md hover:bg-admin-light">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                            </svg>
                            System Settings
                        </a>
                        <a href="#" class="flex items-center px-3 py-2 text-xs text-slate-600 hover:text-admin-primary rounded-md hover:bg-admin-light">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                            Logs
                        </a>
                        <a href="#" class="flex items-center px-3 py-2 text-xs text-slate-600 hover:text-admin-primary rounded-md hover:bg-admin-light">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                            </svg>
                            Backups
                        </a>
                    </div>
                </div>
                
                <a href="{{ path('app_logout') }}" class="flex items-center px-3 py-2 text-sm font-medium text-red-500 hover:text-red-600 rounded-md hover:bg-red-50 transition-colors duration-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span>Logout</span>
                </a>
            </div>
        </aside>
        
        {# Main Content #}
        <div id="mainContent" class="main-content min-h-screen">
            {# Top Navigation Bar #}
            <header class="bg-white shadow-sm py-4 px-6 flex items-center justify-between sticky top-0 z-10">
                <button id="mobileSidebarToggle" class="block md:hidden text-slate-500 hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <div class="flex items-center">
                    <h1 class="text-slate-700 font-semibold ml-2">{{ block('title') }}</h1>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <button id="notificationsDropdown" class="relative p-1 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                            <span class="absolute top-0 right-0 bg-red-500 text-white text-xs rounded-full h-4 w-4 flex items-center justify-center">3</span>
                        </button>
                    </div>
                    <a href="{{ path('app_home') }}" class="p-1 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100" title="View Site">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </a>
                </div>
            </header>
            
            {# Flash Messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="px-6 pt-4">
                        <div class="rounded-xl p-4 {% if label == 'success' %}bg-green-100 text-green-800 border border-green-200{% else %}bg-red-100 text-red-800 border border-red-200{% endif %} flex items-center">
                            {% if label == 'success' %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-green-500" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                            {% else %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-red-500" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                </svg>
                            {% endif %}
                            {{ message }}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {# Main Content #}
            <main class="p-6">
                {% block body %}{% endblock %}
            </main>
            
            {# Footer #}
            <footer class="bg-white border-t border-slate-100 px-6 py-4">
                <div class="text-center text-slate-500 text-sm">
                    &copy; {{ "now"|date("Y") }} CovoitUni Admin. All rights reserved.
                </div>
            </footer>
        </div>
        
        {% block javascripts %}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Sidebar toggle
                const sidebarToggle = document.getElementById('sidebarToggle');
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                
                if (sidebarToggle) {
                    sidebarToggle.addEventListener('click', function() {
                        sidebar.classList.toggle('collapsed');
                        mainContent.classList.toggle('expanded');
                    });
                }
                
                // Mobile sidebar toggle
                const mobileSidebarToggle = document.getElementById('mobileSidebarToggle');
                
                if (mobileSidebarToggle && sidebar) {
                    mobileSidebarToggle.addEventListener('click', function() {
                        if (sidebar.classList.contains('-translate-x-full')) {
                            sidebar.classList.remove('-translate-x-full');
                            sidebar.classList.add('translate-x-0');
                        } else {
                            sidebar.classList.add('-translate-x-full');
                            sidebar.classList.remove('translate-x-0');
                        }
                    });
                }
                
                // Close sidebar on small screens when clicking outside
                document.addEventListener('click', function(event) {
                    const isSmallScreen = window.innerWidth < 768;
                    if (isSmallScreen && sidebar && !sidebar.contains(event.target) && 
                        mobileSidebarToggle && !mobileSidebarToggle.contains(event.target) && 
                        sidebar.classList.contains('translate-x-0')) {
                        sidebar.classList.remove('translate-x-0');
                        sidebar.classList.add('-translate-x-full');
                    }
                });
            });
        </script>
        {% endblock %}
    </body>
</html> 