{% extends 'base.html.twig' %}

{% block title %}Vérification de Participation{% endblock %}

{% block body %}
<div class="container mx-auto px-4 lg:px-8 py-8">
    <div class="max-w-md mx-auto bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="p-6 {% if valid %}bg-primary{% else %}bg-error{% endif %} text-white">
            <h1 class="text-2xl font-bold">Vérification de Participation</h1>
        </div>
        
        <!-- Content -->
        <div class="p-6">
            {% if valid %}
                <div class="flex flex-col items-center space-y-6">
                    <!-- Success Icon -->
                    <div class="flex items-center justify-center w-16 h-16 bg-primary-ultra-light rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    
                    <h2 class="text-xl font-semibold text-gray-800 text-center">Participation Valide</h2>
                    
                    <!-- Participant Info -->
                    <div class="w-full p-4 bg-gray-50 rounded-lg">
                        <h3 class="text-md font-medium text-gray-700 mb-3">Informations du participant :</h3>
                        <div class="space-y-2">
                            <div class="flex items-center">
                                <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                </div>
                                <p class="text-sm text-gray-600">{{ participation.utilisateur.prenom }} {{ participation.utilisateur.nom }}</p>
                            </div>
                            
                            <div class="flex items-center">
                                <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <p class="text-sm text-gray-600">{{ participation.event.nom }}</p>
                            </div>
                            
                            <div class="flex items-center">
                                <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <p class="text-sm text-gray-600">{{ participation.dateInscription|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                    </div>
                    
                    <p class="text-sm text-gray-600 text-center">
                        Cette personne est bien inscrite à l'événement.
                    </p>
                </div>
                
            {% else %}
                <div class="flex flex-col items-center space-y-6">
                    <!-- Error Icon -->
                    <div class="flex items-center justify-center w-16 h-16 bg-red-100 rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </div>
                    
                    <h2 class="text-xl font-semibold text-gray-800 text-center">Participation Non Valide</h2>
                    
                    <p class="text-sm text-gray-600 text-center">
                        {% if error %}
                            {{ error }}
                        {% else %}
                            Impossible de vérifier cette participation.
                        {% endif %}
                    </p>
                </div>
            {% endif %}
            
            <!-- Actions -->
            <div class="mt-8 text-center">
                <a href="{{ path('app_events') }}" class="inline-flex items-center px-4 py-2 bg-gray-200 text-gray-700 rounded-lg shadow hover:bg-gray-300 transition-colors duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                    </svg>
                    Retour aux événements
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %} 