{% extends 'base.html.twig' %}

{% block title %}QR Code de Participation - {{ participation.event.nom }}{% endblock %}

{% block body %}
<div class="container mx-auto px-4 lg:px-8 py-8">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="p-6 bg-primary text-white">
            <h1 class="text-2xl font-bold">QR Code de Participation</h1>
            <p class="text-lg mt-2">{{ participation.event.nom }}</p>
        </div>
        
        <!-- Content -->
        <div class="p-6">
            <div class="flex flex-col items-center space-y-6">
                <!-- QR Code -->
                <div class="p-4 bg-white border-2 border-primary rounded-lg shadow-md">
                    <img src="{{ qrcode }}" alt="QR Code de participation" class="w-64 h-64 mx-auto">
                </div>
                
                <!-- Event Information -->
                <div class="w-full max-w-md p-6 bg-gray-50 rounded-lg">
                    <h2 class="text-xl font-semibold text-gray-800 mb-4">Informations sur l'événement</h2>
                    <div class="space-y-3">
                        <div class="flex items-start">
                            <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-700">Date</p>
                                <p class="text-sm text-gray-600">{{ participation.event.dateEvent|date('d/m/Y') }}</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-700">Heure</p>
                                <p class="text-sm text-gray-600">{{ participation.event.heureEvent|date('H:i') }}</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-700">Lieu</p>
                                <p class="text-sm text-gray-600">{{ participation.event.lieu }}</p>
                            </div>
                        </div>
                        
                        <div class="flex items-start">
                            <div class="flex-shrink-0 p-1 bg-primary-ultra-light rounded-md mr-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-gray-700">Type</p>
                                <p class="text-sm text-gray-600">{{ participation.event.typeEvent.nom }}</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Instructions -->
                <div class="w-full max-w-md">
                    <p class="text-sm text-gray-600 mb-2">
                        Ce QR code servira comme preuve de votre participation à l'événement. 
                        Veuillez le présenter à l'entrée de l'événement pour confirmer votre présence.
                    </p>
                    <p class="text-sm text-gray-600">
                        Vous pouvez également télécharger ce QR code sur votre appareil pour le présenter hors ligne.
                    </p>
                </div>
                
                <!-- Actions -->
                <div class="flex flex-col sm:flex-row space-y-3 sm:space-y-0 sm:space-x-4">
                    <a href="{{ path('app_event_download_qrcode', {'id': participation.idParticipation}) }}" class="px-4 py-2 bg-primary text-white rounded-lg shadow hover:bg-primary-dark transition-colors duration-300 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        Télécharger
                    </a>
                    
                    <a href="{{ path('app_events_show', {'id': participation.event.idEvent}) }}" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg shadow hover:bg-gray-300 transition-colors duration-300 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                        </svg>
                        Retour à l'événement
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 