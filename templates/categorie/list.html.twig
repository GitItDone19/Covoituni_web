{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Categories</h1>
            <a href="{{ path('categorie_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create New Category
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="row">
            {% for categorie in categories %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ categorie.nom }}</h5>
                            <p class="card-text">{{ categorie.description }}</p>
                            
                            <h6 class="mt-3">Features</h6>
                            <ul class="list-unstyled">
                                {% for feature in categorie.features %}
                                    <li>
                                        <i class="fas fa-check text-success"></i>
                                        {{ feature.name }}
                                    </li>
                                {% else %}
                                    <li class="text-muted">No features defined</li>
                                {% endfor %}
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between">
                                <a href="{{ path('categorie_edit', {id: categorie.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <span class="badge bg-secondary">
                                    {{ categorie.cars|length }} cars
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        No categories found. Create your first category to get started.
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %} 