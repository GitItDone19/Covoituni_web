{% extends 'base.html.twig' %}

{% block title %}Tableau de bord passager{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card {
            @apply rounded-xl p-6 relative overflow-hidden;
        }
        .card-icon {
            @apply w-10 h-10 rounded-full flex items-center justify-center mr-3;
        }
        .card-title {
            @apply font-semibold text-gray-800;
        }
        .card-value {
            @apply text-3xl font-bold;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
            <h1 class="text-3xl font-bold mb-4 text-gray-800">Bienvenue, {{ user.prenom }}</h1>
            <p class="text-gray-600 mb-8">Accédez à toutes les fonctionnalités de votre espace passager depuis le menu.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {# Réservations effectuées #}
                <div class="card bg-gradient-to-br from-green-50 to-green-100">
                    <div class="flex items-center mb-3">
                        <div class="card-icon bg-green-100">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="card-title">Réservations effectuées</h3>
                    </div>
                    <p class="card-value text-green-500">{{ user.tripsCount ?? '0' }}</p>
                </div>

                {# Avis donnés #}
                <div class="card bg-gradient-to-br from-yellow-50 to-yellow-100">
                    <div class="flex items-center mb-3">
                        <div class="card-icon bg-yellow-100">
                            <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <h3 class="card-title">Avis donnés</h3>
                    </div>
                    <p class="card-value text-yellow-500">{{ user.reviewsCount ?? '0' }}</p>
                </div>

                {# Événements préférés #}
                <div class="card bg-gradient-to-br from-purple-50 to-purple-100">
                    <div class="flex items-center mb-3">
                        <div class="card-icon bg-purple-100">
                            <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h3 class="card-title">Événements préférés</h3>
                    </div>
                </div>

                {# Économies réalisées #}
                <div class="card bg-gradient-to-br from-green-50 to-green-100">
                    <div class="flex items-center mb-3">
                        <div class="card-icon bg-green-100">
                            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="card-title">Économies réalisées</h3>
                    </div>
                    <p class="card-value text-green-500">€{{ user.savings ?? '0.00' }}</p>
                </div>
            </div>

            <div class="flex flex-wrap gap-4 mt-8">
                <a href="{{ path('app_passager_reservation') }}" class="inline-flex items-center px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Réserver un trajet
                </a>
                <a href="{{ path('app_passager_avis') }}" class="inline-flex items-center px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                    </svg>
                    Ajouter un avis
                </a>
                <a href="{{ path('app_passager_events') }}" class="inline-flex items-center px-4 py-2 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition-colors duration-200">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    Liste des événements
                </a>
            </div>
        </div>
    </div>
{% endblock %}