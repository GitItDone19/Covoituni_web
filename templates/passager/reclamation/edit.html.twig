    <style>
        @keyframes fade-in {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slide-up {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        
        .animate-fade-in {
            animation: fade-in 0.8s ease-out forwards;
        }
        
        .animate-slide-up {
            animation: slide-up 0.6s ease-out 0.2s forwards;
            opacity: 0;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('reclamation-form');
            const subjectInput = document.getElementById('{{ form.subject.vars.id }}');
            const descriptionInput = document.getElementById('{{ form.description.vars.id }}');
            const subjectError = document.getElementById('subject-error');
            const descriptionError = document.getElementById('description-error');
            const validationError = document.getElementById('validation-error');
            const validationMessage = document.getElementById('validation-message');
            const subjectCounter = document.getElementById('subject-counter');
            const descriptionCounter = document.getElementById('description-counter');
            
            // Update character counters
            function updateCounter(input, counter, min, max) {
                const count = input.value.length;
                counter.textContent = `${count}/${max} caractères`;
                
                if (count < min) {
                    counter.classList.remove('text-green-500', 'text-gray-500');
                    counter.classList.add('text-red-500');
                } else if (count > max) {
                    counter.classList.remove('text-green-500', 'text-gray-500');
                    counter.classList.add('text-red-500');
                } else {
                    counter.classList.remove('text-red-500', 'text-gray-500');
                    counter.classList.add('text-green-500');
                }
            }
            
            // Input validation
            function validateInput(input, errorElement, min, max, fieldName) {
                const value = input.value.trim();
                let isValid = true;
                
                if (value === '') {
                    errorElement.textContent = `Le champ ${fieldName} est obligatoire.`;
                    errorElement.classList.remove('hidden');
                    input.classList.add('border-red-500');
                    isValid = false;
                } else if (value.length < min) {
                    errorElement.textContent = `Le ${fieldName} doit contenir au moins ${min} caractères.`;
                    errorElement.classList.remove('hidden');
                    input.classList.add('border-red-500');
                    isValid = false;
                } else if (value.length > max) {
                    errorElement.textContent = `Le ${fieldName} ne doit pas dépasser ${max} caractères.`;
                    errorElement.classList.remove('hidden');
                    input.classList.add('border-red-500');
                    isValid = false;
                } else {
                    errorElement.classList.add('hidden');
                    input.classList.remove('border-red-500');
                }
                
                return isValid;
            }
            
            // Live validation on input
            subjectInput.addEventListener('input', function() {
                updateCounter(subjectInput, subjectCounter, 5, 100);
                validateInput(subjectInput, subjectError, 5, 100, 'sujet');
            });
            
            descriptionInput.addEventListener('input', function() {
                updateCounter(descriptionInput, descriptionCounter, 5, 255);
                validateInput(descriptionInput, descriptionError, 5, 255, 'description');
            });
            
            // Form submission validation
            form.addEventListener('submit', function(event) {
                const isSubjectValid = validateInput(subjectInput, subjectError, 5, 100, 'sujet');
                const isDescriptionValid = validateInput(descriptionInput, descriptionError, 5, 255, 'description');
                
                if (!isSubjectValid || !isDescriptionValid) {
                    event.preventDefault();
                    validationError.classList.remove('hidden');
                    validationMessage.textContent = 'Veuillez corriger les erreurs dans le formulaire avant de soumettre.';
                    
                    // Scroll to the top of the form to show errors
                    validationError.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
            
            // Initial update of counters
            updateCounter(subjectInput, subjectCounter, 5, 100);
            updateCounter(descriptionInput, descriptionCounter, 5, 255);
        });
    </script>
