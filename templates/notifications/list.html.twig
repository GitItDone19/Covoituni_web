{% extends 'base.html.twig' %}

{% block title %}Mes notifications{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-5xl">
    <h1 class="text-2xl font-bold mb-6">Mes notifications</h1>
    
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
            <h2 class="text-lg font-medium text-gray-900">Toutes les notifications</h2>
            <form action="{{ path('app_notifications_mark_all_read') }}" method="post" class="inline">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('mark_all_read') }}">
                <button type="submit" class="text-sm text-primary hover:text-primary-dark font-medium">
                    Marquer tout comme lu
                </button>
            </form>
        </div>
        
        {% if notifications is empty %}
            <div class="py-12 text-center text-gray-500">
                <p>Vous n'avez pas de notifications non lues</p>
            </div>
        {% else %}
            <div class="divide-y divide-gray-200">
                {% for notification in notifications %}
                    <div class="px-4 py-4 sm:px-6 {{ not notification.isRead ? 'bg-blue-50' : '' }}">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                {% if notification.type == 'new_reclamation' %}
                                    <span class="inline-block h-10 w-10 rounded-full bg-orange-100 text-orange-500 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                        </svg>
                                    </span>
                                {% elseif notification.type == 'reclamation_response' %}
                                    <span class="inline-block h-10 w-10 rounded-full bg-green-100 text-green-500 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                                        </svg>
                                    </span>
                                {% endif %}
                            </div>
                            <div class="ml-4 flex-1">
                                <div class="flex items-center justify-between">
                                    <p class="text-sm font-medium text-gray-900">{{ notification.content }}</p>
                                    <p class="text-sm text-gray-500">{{ notification.createdAt|date('d/m/Y H:i') }}</p>
                                </div>
                                <div class="mt-2 flex space-x-4">
                                    <a href="{{ notification.url }}" class="text-sm text-primary hover:text-primary-dark font-medium">Voir détails</a>
                                    <form action="{{ path('app_notifications_mark_read', {'id': notification.id}) }}" method="post" class="inline">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('mark_read') }}">
                                        <button type="submit" class="text-sm text-gray-500 hover:text-gray-700 font-medium">
                                            Marquer comme lu
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %} 